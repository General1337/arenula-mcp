<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<Nullable>disable</Nullable>
		<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
		<IsRoslynComponent>true</IsRoslynComponent>
		<AssemblyName>FrameBasisAnalyzer</AssemblyName>
		<RootNamespace>SBEP.Analyzers.FrameBasis</RootNamespace>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
		<NoWarn>1701;1702;1591;RS1036;</NoWarn>
		<AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
	</PropertyGroup>

	<ItemGroup>
		<!-- Version pinned to match the engine host (engine/Sandbox.Compiling/Sandbox.Compiling.csproj
		     uses Microsoft.CodeAnalysis.CSharp 5.0.0-2.final). Mismatched Roslyn versions cause
		     CompilationWithAnalyzers to silently reject the analyzer when the host invokes it,
		     which empirically dropped FBA001/FBA002 to zero firings at deploy. -->
		<PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.12.0-beta1.25218.8" PrivateAssets="all" />
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0-2.final" PrivateAssets="all" />
	</ItemGroup>
	<!-- [HANDOFF-TRUST: engine host runs Microsoft.CodeAnalysis 5.0.0; analyzer DLL built against 4.7.0 silently rejected by WithAnalyzers under empirically-observed 170 warning count with zero FBA hits despite confirmed assembly load via reflection.list_assemblies type_count=1] -->

</Project>
